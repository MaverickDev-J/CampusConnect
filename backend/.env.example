# ═══════════════════════════════════════════════════════════════
# CampusConnect — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.
# Active PostgreSQL application (postgres_main.py): fill these before running.
# Bootstrap uses owner URLs in the ignored root .env.local and provisions these
# separate restricted API/worker connections. Never use an owner role for the API.
DATABASE_URL=
WORKER_DATABASE_URL=
MIGRATION_DATABASE_URL=
AI_TEXT_PROVIDER=groq
GROQ_API_KEY=
GROQ_BUDGET_PROJECT=groq-default
GEMINI_INGESTION_KEYS=
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=storage
DEMO_ENABLED=false
# Text fallback may use AI_TEXT_PROVIDER=gemini with a valid GEMINI_CHAT_KEYS.
# Groq/Gemini keys within one organization/project still share provider quotas.
# ═══════════════════════════════════════════════════════════════

# ── MongoDB ──────────────────────────────────────────────────
# Local (Docker):
MONGO_URI=mongodb://campusadmin:campuspass123@localhost:27017/campusconnect?authSource=admin
# Legacy/local database reference; the active application uses PostgreSQL above.
# Compose: docker compose -f compose.postgres.yml up -d --wait
# DATABASE_URL=postgresql+psycopg://campusconnect:campusconnect-local@127.0.0.1:5433/campusconnect
# Use a non-owner runtime role and TLS for hosted PostgreSQL.
# Production (Atlas): uncomment and fill
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusconnect?retryWrites=true&w=majority

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ── Gemini API Keys ──────────────────────────────────────────
# Single key (all pools share it):
GEMINI_API_KEY=

# Optional: Separate key pools for credentials and workload management.
# Keys in the same Google project share quota; rotation does not increase it.
# Comma-separated for multiple keys per pool.
# GEMINI_ROUTER_KEYS=key1,key2
# GEMINI_CHAT_KEYS=key1,key2
# GEMINI_INGESTION_KEYS=key1,key2

# PostgreSQL staging: all API/worker instances and key pools share this budget.
# Migration 008 seeds conservative app caps for this label; these are not Google's
# verified free-tier limits. Use scripts.ai_budget with migration-owner credentials
# to inspect/lower them. Changing this label requires provisioning policies first.
GEMINI_BUDGET_PROJECT=campusconnect-default

# ── Superadmin ───────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@campusconnect.local
SUPERADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# ── CORS (Production) ───────────────────────────────────────
# Set this to your production frontend URL when deploying
# CORS_ORIGIN=https://campusconnect.yourdomain.com
